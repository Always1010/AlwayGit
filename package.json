{
  "name": "alwaygit",
  "displayName": "%manifest.displayName%",
  "description": "%manifest.description%",
  "version": "0.51.1",
  "publisher": "alwaygit-dev",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "worktree",
    "commit"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*",
    "onWebviewPanel:alwaygit.workbench"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%manifest.capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "alwaygit.newTerminal",
        "title": "%manifest.newTerminal%",
        "category": "AlwayGit",
        "icon": "$(terminal)"
      },
      {
        "command": "alwaygit.showWorkbench",
        "title": "%manifest.contributes.commands.item0.title%",
        "category": "%manifest.contributes.commands.item0.category%",
        "icon": "$(git-merge)"
      },
      {
        "command": "alwaygit.openWorkbenchInNewWindow",
        "title": "%manifest.contributes.commands.item1.title%",
        "category": "%manifest.contributes.commands.item1.category%",
        "icon": "$(window)"
      },
      {
        "command": "alwaygit.workbenchOpenModeSettings",
        "title": "%manifest.openModeSettings%",
        "category": "AlwayGit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "alwaygit.moveWorkbenchView",
        "title": "%manifest.moveWorkbenchView%",
        "category": "AlwayGit",
        "icon": "$(move)"
      },
      {
        "command": "alwaygit.openWorkbenchInEditor",
        "title": "%manifest.openInEditor%",
        "category": "AlwayGit"
      },
      {
        "command": "alwaygit.openWorkbenchInSidebar",
        "title": "%manifest.openInSidebar%",
        "category": "AlwayGit"
      },
      {
        "command": "alwaygit.openWorkbenchInPanel",
        "title": "%manifest.openInPanel%",
        "category": "AlwayGit"
      },
      {
        "command": "alwaygit.copyWorkbenchToEditor",
        "title": "%manifest.copyToEditor%",
        "category": "AlwayGit"
      },
      {
        "command": "alwaygit.sidebarLocationSettings",
        "title": "%manifest.openModeSettings%",
        "category": "AlwayGit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "alwaygit.panelLocationSettings",
        "title": "%manifest.openModeSettings%",
        "category": "AlwayGit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "alwaygit.openWorkbenchInAuxiliary",
        "title": "%manifest.openInAuxiliary%",
        "category": "AlwayGit"
      },
      {
        "command": "alwaygit.auxiliaryLocationSettings",
        "title": "%manifest.openModeSettings%",
        "category": "AlwayGit",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "alwaygit.newTerminal",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alwaygit",
          "title": "%manifest.contributes.viewsContainers.activitybar.item0.title%",
          "icon": "media/alwaygit.svg"
        }
      ],
      "panel": [
        {
          "id": "alwaygit-panel",
          "title": "AlwayGit",
          "icon": "media/alwaygit.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "alwaygit-auxiliary",
          "title": "AlwayGit",
          "icon": "media/alwaygit.svg"
        }
      ]
    },
    "views": {
      "alwaygit": [
        {
          "id": "alwaygit.workbenchLauncher",
          "name": "%manifest.contributes.views.alwaygit.item0.name%",
          "type": "webview"
        }
      ],
      "alwaygit-panel": [
        {
          "id": "alwaygit.workbenchPanel",
          "name": "%manifest.panelWorkbench%",
          "when": "alwaygit.panelLocationEnabled",
          "type": "webview"
        }
      ],
      "alwaygit-auxiliary": [
        {
          "id": "alwaygit.workbenchAuxiliary",
          "name": "%manifest.auxiliaryWorkbench%",
          "when": "alwaygit.auxiliaryLocationEnabled",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "%manifest.contributes.configuration.title%",
      "properties": {
        "alwaygit.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN",
            "auto"
          ],
          "default": "en",
          "description": "%manifest.contributes.configuration.properties.alwaygit.language.description%",
          "scope": "application"
        },
        "alwaygit.gitPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%manifest.contributes.configuration.properties.alwaygit.gitPath.description%"
        },
        "alwaygit.historyPageSize": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 1000,
          "description": "%manifest.contributes.configuration.properties.alwaygit.historyPageSize.description%"
        },
        "alwaygit.refreshInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 300,
          "description": "%manifest.contributes.configuration.properties.alwaygit.refreshInterval.description%"
        },
        "alwaygit.allowDetachedHead": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%manifest.contributes.configuration.properties.alwaygit.allowDetachedHead.description%"
        },
        "alwaygit.pushFollowTags": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%manifest.contributes.configuration.properties.alwaygit.pushFollowTags.description%"
        },
        "alwaygit.pushTagAfterCreate": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%manifest.contributes.configuration.properties.alwaygit.pushTagAfterCreate.description%"
        },
        "alwaygit.defaultResetMode": {
          "type": "string",
          "enum": [
            "soft",
            "mixed",
            "hard"
          ],
          "default": "mixed",
          "scope": "window",
          "description": "%manifest.contributes.configuration.properties.alwaygit.defaultResetMode.description%"
        },
        "alwaygit.interfaceSettings": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": false,
          "properties": {
            "font": {
              "type": "number",
              "minimum": 10,
              "maximum": 22
            },
            "row": {
              "type": "number",
              "minimum": 20,
              "maximum": 48
            },
            "changeListMode": {
              "type": "string",
              "enum": [
                "split",
                "unified"
              ]
            },
            "diffNavigationScope": {
              "type": "string",
              "enum": [
                "commit",
                "file"
              ]
            },
            "singleKeyShortcuts": {
              "type": "boolean"
            },
            "shortcutOverrides": {
              "type": "object"
            },
            "appearance": {
              "type": "object"
            }
          },
          "description": "%manifest.contributes.configuration.properties.alwaygit.interfaceSettings.description%"
        },
        "alwaygit.openMode": {
          "type": "string",
          "enum": [
            "editor",
            "docked"
          ],
          "enumDescriptions": [
            "%manifest.editorModeDescription%",
            "%manifest.dockedModeDescription%"
          ],
          "default": "editor",
          "scope": "application",
          "description": "%manifest.legacyOpenMode%",
          "deprecationMessage": "%manifest.legacyOpenMode%"
        },
        "alwaygit.workbenchLocations": {
          "type": "object",
          "scope": "application",
          "description": "%manifest.workbenchLocationsDescription%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "editor",
                  "sidebar",
                  "auxiliary",
                  "panel"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "description": "%manifest.enabledLocationsDescription%"
            },
            "default": {
              "type": "string",
              "enum": [
                "editor",
                "sidebar",
                "auxiliary",
                "panel"
              ],
              "description": "%manifest.defaultLocationDescription%"
            }
          },
          "required": [
            "enabled",
            "default"
          ]
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "alwaygit.sidebarLocationSettings",
          "when": "view == alwaygit.workbenchLauncher",
          "group": "navigation@1"
        },
        {
          "command": "alwaygit.panelLocationSettings",
          "when": "view == alwaygit.workbenchPanel",
          "group": "navigation@1"
        },
        {
          "command": "alwaygit.auxiliaryLocationSettings",
          "when": "view == alwaygit.workbenchAuxiliary",
          "group": "navigation@1"
        },
        {
          "command": "alwaygit.openWorkbenchInNewWindow",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@1"
        },
        {
          "command": "alwaygit.moveWorkbenchView",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@2"
        },
        {
          "command": "alwaygit.openWorkbenchInEditor",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@3"
        },
        {
          "command": "alwaygit.openWorkbenchInSidebar",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@4"
        },
        {
          "command": "alwaygit.openWorkbenchInPanel",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@5"
        },
        {
          "command": "alwaygit.openWorkbenchInAuxiliary",
          "when": "view == alwaygit.workbenchLauncher || view == alwaygit.workbenchPanel || view == alwaygit.workbenchAuxiliary",
          "group": "workbench@6"
        }
      ],
      "commandPalette": [
        {
          "command": "alwaygit.sidebarLocationSettings",
          "when": "false"
        },
        {
          "command": "alwaygit.panelLocationSettings",
          "when": "false"
        },
        {
          "command": "alwaygit.auxiliaryLocationSettings",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs && vite build",
    "watch:extension": "node scripts/build.mjs --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "npm run i18n:check && tsc --noEmit",
    "test": "vitest run",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "test:windows": "npm run build && node scripts/test-windows.mjs",
    "package": "node scripts/package.mjs",
    "i18n:generate": "node scripts/i18n.mjs generate",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:export": "node scripts/i18n.mjs export"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "^26.4.2",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
